{
  "schema_version": 1,
  "harnesses": [
    {
      "id": "cline",
      "package": "cline",
      "version": "3.0.60",
      "install": "npm install -g cline@3.0.60",
      "provider": "openrouter",
      "supports_json": true,
      "notes": "Uses isolated --data-dir per trial and Cline CLI headless JSON mode."
    },
    {
      "id": "kilo",
      "package": "@kilocode/cli",
      "version": "7.5.9",
      "install": "npm install -g @kilocode/cli@7.5.9",
      "provider": "openrouter",
      "supports_json": false,
      "notes": "Uses kilo run --auto with an isolated workspace kilo.json per trial."
    }
  ]
}
