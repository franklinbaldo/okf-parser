{
  "name": "okf-parser",
  "version": "0.17.0",
  "description": "Native TypeScript parser, validator, formatter, graph inspector, schema exporter, and MCP server for Open Knowledge Format bundles",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "okf-parser-ts": "./dist/cli.js",
    "okf-parser-ts-mcp": "./dist/mcp-cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "markdown-it": "^14.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "@types/unist": "^3.0.3",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "okf",
    "open-knowledge-format",
    "markdown",
    "formatter",
    "knowledge-graph",
    "json-schema",
    "zod",
    "mcp",
    "model-context-protocol",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franklinbaldo/okf-parser.git",
    "directory": "typescript"
  }
}
