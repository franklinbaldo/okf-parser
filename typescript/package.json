{
  "name": "okf-parser",
  "version": "0.8.0",
  "description": "Native TypeScript parser, validator, graph inspector, and schema exporter for Open Knowledge Format bundles",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "okf-parser-ts": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "markdown-it": "^14.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "okf",
    "open-knowledge-format",
    "markdown",
    "knowledge-graph",
    "json-schema",
    "zod",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/franklinbaldo/okf-parser.git",
    "directory": "typescript"
  }
}
