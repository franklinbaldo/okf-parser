# README.pypi.md is derived from README.md by scripts/pypi_readme.py for the
# PyPI long description. It carries no frontmatter by design, because stripping
# it is the whole point, so it is a packaging artifact rather than a concept.
/README.pypi.md

# Embedded type-pack sources are standalone OKF bundles. Dedicated pack tests
# validate them from their own roots so their domain specs do not leak into the
# repository-level docs/types contract.
/src/okf_parser/packs/

# The upstream conformance corpus is a set of standalone fixture bundles, many
# of them non-conformant on purpose. tests/test_upstream_conformance.py loads
# each one from its own root; see conformance/README.md.
/conformance/upstream/
